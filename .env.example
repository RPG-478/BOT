# AGOBOT の設定例。実際の値は .env に書き、.env は絶対にコミット・チャットに貼らないこと。
TOKEN=
SUPABASE_URL=https://<project-ref>.supabase.co
# 通常使うキー（公開用の anon キー）。
SUPABASE_KEY=
# bump/up RTAのRPCはservice_role専用。RTAを使うBot実行環境では設定が必要。
# 設定したときだけ SUPABASE_KEY より優先される。Vercel には絶対に入れない。
# SUPABASE_SERVICE_ROLE_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
