# AGOBOT の設定例。実際の値は .env に書き、.env は絶対にコミット・チャットに貼らないこと。
TOKEN=
SUPABASE_URL=https://<project-ref>.supabase.co
# 通常使うキー（公開用の anon キー）。
SUPABASE_KEY=
# anonキーでRTA RPCを使う場合は docs/sql/anon_bump_rta_rpc.sql を適用する。
# service_roleキーも利用可能。設定したときだけ SUPABASE_KEY より優先される。
# service_roleキーはVercelなど公開クライアント環境には絶対に入れない。
# SUPABASE_SERVICE_ROLE_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
